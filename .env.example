# Public site URL used for metadata, sitemap, and robots.
# Fallback: https://nisa-retire-countdown.vercel.app
NEXT_PUBLIC_SITE_URL=https://nisa-retire-countdown.vercel.app

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# When unset, GA scripts are not loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Operator / contact info for ASP review pages (about, contact, privacy, terms).
# Until set, pages show「公開時に記入」placeholders — fill before applying to ASPs.
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_ADDRESS=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Affiliate partner URLs (optional). Soft CTAs only appear when at least one is set.
# NEXT_PUBLIC_AFFILIATE_SECURITIES_URL=
# NEXT_PUBLIC_AFFILIATE_CREDIT_CARD_URL=
