# Public site URL used for metadata, sitemap, robots, and OG image host.
# Set this to your custom domain in production (Vercel → Environment Variables).
# Example: https://example.jp
# Fallback order: NEXT_PUBLIC_SITE_URL → Vercel production host → *.vercel.app
NEXT_PUBLIC_SITE_URL=https://nisa-retire-countdown.vercel.app

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# When unset, GA scripts are not loaded. Set in Vercel for production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GBP455GDLM

# --- お問い合わせ・所在地（本番では Vercel に設定）---
# 手順:
# 1. Vercel Dashboard → 対象プロジェクト → Settings → Environment Variables
# 2. Production（必要なら Preview も）に追加して Save
# 3. Redeploy（Deployments → 最新 → Redeploy）して反映を確認
#
# NEXT_PUBLIC_CONTACT_EMAIL は本番のお問い合わせに必須です。
# 未設定時はフォーム送信が無効になり、「メール受付を準備中」と表示されます。
# 所在地（NEXT_PUBLIC_OPERATOR_ADDRESS）は空なら行ごと非表示。
# 運営者名（NEXT_PUBLIC_OPERATOR_NAME）は公開しないため不要です。
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=contact@nisa-simulation.com

# Affiliate partner URLs (optional). Soft CTAs only appear when at least one is set.
# Set in Vercel → Settings → Environment Variables, then Redeploy.
# Use the /sp/cc?rk=... click URL (not the banner img).
# AccessTrade マネックス証券 — use the /sp/cc?rk=... click URL (not the banner img).
# NEXT_PUBLIC_AFFILIATE_SECURITIES_URL=https://h.accesstrade.net/sp/cc?rk=YOUR_RK
# AccessTrade EPOSカード (program 654368) — use the /sp/cc?rk=... click URL (not the banner img).
# NEXT_PUBLIC_AFFILIATE_CREDIT_CARD_URL=https://h.accesstrade.net/sp/cc?rk=YOUR_RK

# --- Threads 自動投稿（GitHub Actions Secrets に設定。ローカル確認用）---
# 手順は scripts/threads/README.md
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=
# THREADS_AUTO_POST=false
#
# 雑談自動生成（scripts/threads/generate_casual.py / threads-casual-refill.yml）
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
